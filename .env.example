# Copy these settings to your deployment environment.
# Local Windows startup does not require this file.
HOST=127.0.0.1
PORT=3000
# Set the exact HTTPS origin when deploying (no trailing path).
# PUBLIC_URL=https://elastic.example.uz
# DATABASE_PATH=./data/micro.sqlite

# Render: HOST=0.0.0.0, DATABASE_PATH=/var/data/micro.sqlite
# BACKUP_PATH=/var/data/backups
# PUBLIC_URL=https://your-domain.uz (after domain verification)

# Optional Geoapify map/search key, restricted to your HTTPS website Referer.
# GEOAPIFY_API_KEY=

# Only for a local reverse proxy that overwrites X-Real-IP (e.g. our Hetzner Nginx).
# Keep disabled when exposing Node directly or using a remote managed proxy.
# TRUST_LOOPBACK_PROXY=1
